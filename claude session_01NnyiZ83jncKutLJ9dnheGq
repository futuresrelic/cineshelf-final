Database Changes Needed:
1. New Table: containers (Box Sets)

CREATE TABLE containers (
    id INTEGER PRIMARY KEY,
    user_id INTEGER,
    name TEXT,              -- "The Matrix Trilogy"
    spine_label TEXT,       -- What shows on shelf spine
    format TEXT,            -- "Blu-ray Box Set"
    edition TEXT,           -- "Ultimate Collection"
    condition TEXT,
    purchase_date DATE,
    purchase_price DECIMAL,
    notes TEXT,
    created_at DATETIME
);

2. New Table: container_contents

CREATE TABLE container_contents (
    id INTEGER PRIMARY KEY,
    container_id INTEGER,
    copy_id INTEGER,        -- Links to existing copies
    disc_number INTEGER,    -- Disc 1, 2, 3, etc.
    FOREIGN KEY (container_id) REFERENCES containers(id) ON DELETE CASCADE,
    FOREIGN KEY (copy_id) REFERENCES copies(id) ON DELETE CASCADE
);

3. Update shelf_assignments

ALTER TABLE shelf_assignments ADD COLUMN container_id INTEGER;
-- Either copy_id OR container_id is set (not both)

