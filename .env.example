# CineShelf Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# === Database Configuration ===
# Path to SQLite database file (Railway will use /app/data by default)
DB_PATH=/app/cineshelf.futuresrelic.com/data/cineshelf.sqlite

# === TMDB API Configuration ===
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# === Google OAuth Configuration ===
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Update this to your Railway domain after deployment
GOOGLE_REDIRECT_URI=https://your-app.railway.app/api/auth.php

# === UMDB API Configuration ===
# Physical media database — powers release/edition lookups for umdb-* IDs
# Required for pushing editions to UMDB (POST /api/v1/releases)
# Read-only lookups work without a key; write operations require it
UMDB_API_KEY=

# === OpenAI API Configuration (Optional) ===
# Required for AI cover scanner (Scan Cover + Scan & Match buttons)
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# === OMDb API Configuration (Optional) ===
# Enables the OMDB tab in the Cover Scanner "Scan & Match" feature
# Free key (1,000 req/day) at: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# === Application Configuration ===
# Environment: production or development
NODE_ENV=production

# Debug mode: true for development (shows errors), false for production
DEBUG_MODE=false

# Port (Railway sets this automatically, don't change)
PORT=8080
